<?xml version="1.0" encoding="utf-8"?>
<!--
  App 图标背景层（adaptive icon background）。
  设计：红色对角渐变 + 5 根严格等差递增的实心红色矩形，组成向上"楼梯"。
  底部最大、最右最高，K 线阶梯式爬升；矩形全部为实心长方形，无 wick/影线。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#C8362E"
                android:endColor="#5A1010" />
        </aapt:attr>
    </path>

    <!-- 5 根严格等差递增的红矩形（K 线阶梯）。
         width=14, 每根底部逐级 +2dp，每根比前一根高 4dp（顶部逐级 -2dp）。
         x: 8,26,44,62,80；每根宽 14、高 14/18/22/26/30。 -->
    <path android:fillColor="#E54D42" android:pathData="M8,44 H22 V58 H8 Z" />
    <path android:fillColor="#E54D42" android:pathData="M26,42 H40 V60 H26 Z" />
    <path android:fillColor="#E54D42" android:pathData="M44,40 H58 V62 H44 Z" />
    <path android:fillColor="#E54D42" android:pathData="M62,38 H76 V64 H62 Z" />
    <path android:fillColor="#E54D42" android:pathData="M80,36 H94 V66 H80 Z" />
</vector>